{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "padding": {"left": 5, "top": 5, "right": 190, "bottom": 5},
  "title": {
    "text": "The Generation Gap",
    "subtitle": "Alcohol preference by age group",
    "font": "Oswald",
    "fontSize": 20,
    "subtitleFont": "Montserrat",
    "subtitleColor": "#8A6B4C"
  },
  "data": {
    "url": "ndshs_alcohol_preferences_2022_2023.json"
  },
  "transform": [
    {"filter": "datum.Gender == 'Persons'"},
    {
      "fold": [
        "Regular strength beer", "Pre-mixed spirits", "Bottled wine"
      ],
      "as": ["Alcohol Type", "Percentage"]
    }
  ],
  "encoding": {
    "x": {
      "field": "Age Group",
      "type": "ordinal",
      "axis": {"labelAngle": 0, "labelFont": "Montserrat", "title": null, "grid": false}
    },
    "y": {
      "field": "Percentage",
      "type": "quantitative",
      "axis": {"title": "Preference (%)", "labelFont": "Montserrat", "titleFont": "Montserrat", "grid": true, "gridColor": "#E5E7EB"}
    },
    "color": {
      "field": "Alcohol Type",
      "type": "nominal",
      "scale": {
        "domain": ["Regular strength beer", "Pre-mixed spirits", "Bottled wine"],
        "range": ["#D97706", "#7C2D12", "#F59E0B"]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 3, "point": {"filled": true, "size": 70}},
      "encoding": {
        "tooltip": [
          {"field": "Age Group", "type": "nominal"},
          {"field": "Alcohol Type", "type": "nominal"},
          {"field": "Percentage", "type": "quantitative", "format": ".1f", "title": "Preference %"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum['Age Group'] == '70+'"}],
      "mark": {"type": "text", "align": "left", "dx": 8, "font": "Montserrat", "fontWeight": "bold", "fontSize": 12},
      "encoding": {
        "text": {"field": "Alcohol Type", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "datum['Age Group'] == '18–24' && datum['Alcohol Type'] == 'Regular strength beer'"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -16,
        "font": "Oswald",
        "fontSize": 14,
        "color": "#D97706"
      },
      "encoding": {
        "text": {"value": "18–24: regular beer trails the midlife peak"}
      }
    },
    {
      "transform": [{"filter": "datum['Age Group'] == '30–39' && datum['Alcohol Type'] == 'Regular strength beer'"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -18,
        "font": "Oswald",
        "fontSize": 14,
        "color": "#7C2D12"
      },
      "encoding": {
        "text": {"value": "30–39: regular beer peak"}
      }
    }
  ],
  "config": {"view": {"stroke": "transparent"}, "font": "Montserrat"}
}
