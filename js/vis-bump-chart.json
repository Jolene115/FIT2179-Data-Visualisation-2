{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "title": {
    "text": "Consistency at the Top",
    "subtitle": "Top 20 in 2025 compared with the previous poll; ranks below 25 are clipped and annotated",
    "font": "Oswald",
    "fontSize": 20,
    "subtitleFont": "Montserrat",
    "subtitleColor": "#8A6B4C"
  },
  "data": {
    "url": "gabs_hottest_100_2025.json"
  },
  "transform": [
    {"filter": "datum.rank <= 20"},
    {"calculate": "datum.rank", "as": "Rank_2025"},
    {
      "calculate": "datum.status == '=' ? datum.rank : indexof(datum.status, 'Up ') == 0 ? datum.rank + toNumber(substring(datum.status, 3)) : indexof(datum.status, 'Down ') == 0 ? datum.rank - toNumber(substring(datum.status, 5)) : null",
      "as": "Rank_2023"
    },
    {"filter": "datum.Rank_2023 != null"},
    {
      "fold": ["Rank_2023", "Rank_2025"],
      "as": ["YearField", "PlotRank"]
    },
    {
      "calculate": "datum.YearField == 'Rank_2023' ? 'Previous poll' : '2025'",
      "as": "Year"
    },
    {
      "calculate": "datum.PlotRank > 25 ? 25 : datum.PlotRank",
      "as": "PlotRankCapped"
    },
    {
      "calculate": "'was #' + datum.PlotRank",
      "as": "PreviousRankLabel"
    },
    {
      "calculate": "datum.Rank_2023 > datum.Rank_2025 ? 'Up' : datum.Rank_2023 < datum.Rank_2025 ? 'Down' : 'Same'",
      "as": "Momentum"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "sort": ["Previous poll", "2025"],
      "axis": {"labelFont": "Montserrat", "title": null, "labelPadding": 10, "labelFontSize": 14}
    },
    "y": {
      "field": "PlotRankCapped",
      "type": "quantitative",
      "scale": {"domain": [1, 25], "reverse": true},
      "axis": {"labelFont": "Montserrat", "titleFont": "Montserrat", "title": "GABS Rank (1 is best)", "grid": true, "gridColor": "#E5E7EB"}
    },
    "color": {
      "field": "Momentum",
      "type": "nominal",
      "scale": {
        "domain": ["Up", "Same", "Down"],
        "range": ["#D97706", "#9CA3AF", "#7C2D12"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "beer", "type": "nominal", "title": "Beer"},
      {"field": "brewery", "type": "nominal", "title": "Brewery"},
      {"field": "Rank_2023", "type": "quantitative", "title": "Previous rank"},
      {"field": "Rank_2025", "type": "quantitative", "title": "2025 rank"}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {"filled": true, "size": 55, "opacity": 1},
        "strokeWidth": 2.5
      },
      "encoding": {
        "detail": {"field": "beer", "type": "nominal"}
      }
    },
    {
      "transform": [{"filter": "datum.Year == '2025' && datum.Rank_2025 <= 12"}],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "font": "Montserrat",
        "fontWeight": "bold",
        "fontSize": 10
      },
      "encoding": {
        "text": {"field": "beer", "type": "nominal"},
        "color": {"value": "#2F2720"}
      }
    },
    {
      "transform": [{"filter": "datum.Year == 'Previous poll' && datum.PlotRank > 25"}],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 8,
        "font": "Montserrat",
        "fontSize": 10,
        "color": "#7C2D12"
      },
      "encoding": {
        "text": {"field": "PreviousRankLabel", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "Montserrat"
  }
}
